<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark parent + purple window background so there is no white flash between the
         splash screen and Compose's first frame. -->
    <style name="Theme.FplGuide" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fpl_purple</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.FplGuide.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fpl_purple</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.FplGuide</item>
    </style>
</resources>
